# Copy to .env.local for `vercel dev`, and add the same keys in
# Vercel → Project → Settings → Environment Variables.
# Find them in Supabase → Project Settings → API (or "API Keys").

# Project URL, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=

# Public client key (legacy "anon" key, or the newer "publishable" key).
# Safe to expose to the browser: RLS policies protect the data.
SUPABASE_ANON_KEY=

# Server-only key (legacy "service_role" key, or the newer "secret" key).
# NEVER expose this to the browser or commit it. It bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=
